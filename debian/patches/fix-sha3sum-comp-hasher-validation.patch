Description: Skip broken sha3-*sum comparison in hasher test on Ubuntu resolute
 uutils-coreutils sha3-256sum (0.8.0) on Ubuntu resolute emits wc-style byte
 counts instead of hex digests. Probe the comparison hasher output before
 using it to build a checker file, and deactivate that sub-test if the output
 is not a recognisable hex hash string.
Origin: ubuntu
Bug-Ubuntu: https://bugs.launchpad.net/ubuntu/+source/leancrypto/+bug/0
Forwarded: not-needed
Last-Update: 2026-04-27
--- a/apps/tests/hasher-test.sh
+++ b/apps/tests/hasher-test.sh
@@ -62,16 +62,28 @@ fi
 
 if [ -x "$COMP_HASHER" ]
 then
-	run_hasher $COMP_HASHER $0 | sed -E 's/(\w+\s)\s/\1*/' >$CHKFILE
-	run_hasher $LC_HASHER --status -c $CHKFILE
-	if [ $? -eq 0 ]
-	then
-		echo_pass "Parsing checker file with asterisk with $LC_HASHER"
-	else
-		echo_fail "Parsing checker file with asterisk (binary mode) with $LC_HASHER failed"
-	fi
+        # Validate that COMP_HASHER produces standard "<hash>  <file>" output.
+        # Some implementations (e.g. uutils coreutils sha3-256sum 0.8.0 on
+        # Ubuntu resolute) are broken and emit wc-style byte counts instead of
+        # a hex digest, which would produce a malformed checker file and a
+        # spurious test failure.  Deactivate the comparison sub-test when the
+        # output doesn't look like a hex hash string.
+        _probe_out=$("$COMP_HASHER" /dev/null 2>/dev/null)
+        if ! printf '%s' "$_probe_out" | grep -qE '^[0-9a-fA-F]{32,}[[:space:]]'
+        then
+                echo_deact "Compare hasher $COMP_HASHER does not produce compatible hash output (skipping asterisk check)"
+        else
+                run_hasher $COMP_HASHER $0 | sed -E 's/(\w+\s)\s/\1*/' >$CHKFILE
+                run_hasher $LC_HASHER --status -c $CHKFILE
+                if [ $? -eq 0 ]
+                then
+                        echo_pass "Parsing checker file with asterisk with $LC_HASHER"
+                else
+                        echo_fail "Parsing checker file with asterisk (binary mode) with $LC_HASHER failed"
+                fi
+        fi
 else
-	echo_deact "Compare hasher $COMP_HASHER does not exist"
+        echo_deact "Compare hasher $COMP_HASHER does not exist"
 fi
 
 run_hasher $LC_HASHER $0 | run_hasher $LC_HASHER --status -c -
